# FastAPI backend — offline çalışır
FROM python:3.11-slim

WORKDIR /app
COPY requirements.txt .
# yalnız çekirdek + API bağımlılıkları (model katmanı ayrı imajlarda)
RUN pip install --no-cache-dir fastapi uvicorn pydantic

COPY src/ ./src/
COPY config/ ./config/
COPY data/ ./data/

EXPOSE 8000
CMD ["uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
