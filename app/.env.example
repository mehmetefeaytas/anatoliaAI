# Anatolia AI — örnek ortam değişkenleri (API ANAHTARI YOK; sadece local config)
# İlgili: CLAUDE.md §20 (gizli bilgi yok), ../decisions/on-premise-calistirilabilir-mimari.md

# --- DB ---
# Demo (offline): in-memory SQLite. Üretim: Postgres bağlantısı.
DATABASE_PATH=:memory:
# DATABASE_URL=postgresql://anatolia:anatolia@postgres:5432/anatolia

# --- pipeline ---
BANKS_CONFIG=config/banks.yaml
RAW_DIR=data/raw

# --- LLM (OPSİYONEL; boşsa kural-only çalışır) ---
# LLM_BACKEND=vllm        # veya: ollama
VLLM_URL=http://localhost:8001
VLLM_MODEL=Trendyol-LLM-8B-T1
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- modeller (offline; önceden indirilmiş) ---
# BERTURK_MODEL_DIR=/models/berturk-kampanya-8sinif

# --- web ---
NEXT_PUBLIC_API_URL=http://localhost:8000
