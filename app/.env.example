# Anatolia AI — örnek ortam değişkenleri (API ANAHTARI YOK; sadece local config)
# İlgili: CLAUDE.md §20 (gizli bilgi yok), ../decisions/on-premise-calistirilabilir-mimari.md

# --- DB ---
# Demo (offline): in-memory SQLite. Üretim: Postgres bağlantısı.
DATABASE_PATH=:memory:
# DATABASE_URL=postgresql://anatolia:anatolia@postgres:5432/anatolia

# --- pipeline ---
BANKS_CONFIG=config/banks.yaml
RAW_DIR=data/raw

# --- işlem günlüğü (audit log) ---
# Her API isteği buraya tek satır JSON olarak eklenir; yazan uçlar ayrıca
# işaretlenir ve panelin "İşlem Günlüğü" sekmesi bunu okur. Dosya bir ÇALIŞMA
# ARTEFAKTIDIR, depoya girmez (`.gitignore`). Ne kaydedildiği/kaydedilmediği ve
# döndürme politikası: `src/api/gunluk.py` modül başlığı.
AUDIT_LOG_PATH=data/gunluk/islem-gunlugu.jsonl
# Etkin dosyanın üst sınırı (bayt). Aşıldığında `.1`, `.2`, … olarak döndürülür
# ve döndürmenin kendisi de kayda düşer.
AUDIT_LOG_MAX_BYTES=5242880
# Saklanan döndürülmüş kuşak sayısı. Toplam tavan = (N+1) × AUDIT_LOG_MAX_BYTES.
AUDIT_LOG_KEEP=3

# --- LLM (OPSİYONEL; boşsa kural-only çalışır) ---
# LLM_BACKEND=vllm        # veya: ollama. Boşsa NullLLMExtractor (kasıtlı offline).
#
# LLM_STRICT=1 -> LLM hatası YUTULMAZ, exception yükselir.
# Eval/ablasyon bu modda koşulmalıdır: aksi halde LLM hiç çalışmamışken bile
# ablasyon tablosu "hibrit = kural-only" satırını hatasız basar ve jüriye
# yanıltıcı bir artefakt gider. Üretim/demo yolunda BOŞ bırakın — LLM kritik
# yolda değildir, hatası pipeline'ı durdurmamalıdır (CLAUDE.md §11).
# LLM_STRICT=1

# vLLM (birincil). 8001 bilerek: 8000 API'nin KENDİ portudur.
VLLM_URL=http://localhost:8001
# Yalnız Apache-2.0/MIT ağırlık (şartname §5.10). Qwen3 ailesi Apache-2.0.
#
# Trendyol-LLM-8B-T1 üzerindeki BLOKE **31 Tem 2026'da KALDIRILDI**: taban
# model zinciri köke kadar takip edildi ve temiz çıktı
# (`Qwen3-8B-Base → Qwen3-8B → Trendyol-8B`, Llama/Gemma yok, Apache-2.0).
# Ayrıntı ve kanıt: docs/model-license-audit.md §"BLOKE kararının kaldırılması".
# `docker-compose.yml` bu yüzden o modeli kullanıyor; buradaki satır eski
# bloke notunu taşıdığı için çelişkili görünüyordu.
VLLM_MODEL=Qwen/Qwen3-8B
# Yapılandırılmış çıktı (structured output) modu normalde OTOMATİK bulunur:
# kod 1 token'lık gerçek isteklerle dört modu dener, ilk çalışanı cache'ler.
# Sürüm tahmini YAPILMAZ. Yalnızca pazarlığı atlamak isterseniz sabitleyin:
#   json_schema | structured_outputs | guided_json | prompt_only
# VLLM_STRUCTURED_MODE=json_schema

# Ollama (demo yedeği, CPU/offline). Teslim makinesi için Qwen3-4B GGUF önerilir.
OLLAMA_URL=http://localhost:11434
# Etiket BİREBİR eşleşir, kısaltma çözülmez: `qwen2.5:7b` kurulu değildir ve
# "model not found" verir. Ablasyonda ölçülen ağırlık budur (Q4_K_M, Apache-2.0).
OLLAMA_MODEL=qwen2.5:7b-instruct
# Model bellekte kalsın; 4 dakikalık sunumda yeniden yükleme beklenmesin.
OLLAMA_KEEP_ALIVE=30m
# Düşünme (thinking) kipi. VARSAYILAN KAPALI ve öyle kalmalı: Qwen3 ve sonrası
# cevaptan önce muhakeme token'ı üretir, bu da `OLLAMA_NUM_PREDICT` bütçesini
# yiyip BOŞ cevap bırakır. Ölçüldü (2026-08-13, qwen3.5:9b-q4_K_M): açıkken
# 29,2 sn / 512 token / boş içerik, kapalıyken 3,5 sn / 63 token / dolu içerik.
# Yalnız muhakemenin etkisini ÖLÇMEK için açın.
# OLLAMA_THINK=1
# Ollama varsayılanı 2048'dir ve 6 few-shot örneği + uzun kampanya metnini
# SESSİZCE kırpar (sistem yönergesi başından kaybolur). Açıkça büyütülür.
OLLAMA_NUM_CTX=8192

# --- modeller (offline; önceden indirilmiş) ---
# BERTURK_MODEL_DIR=/models/berturk-kampanya-8sinif

# --- web ---
NEXT_PUBLIC_API_URL=http://localhost:8000
